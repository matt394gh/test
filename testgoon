import random

geheime_zahl = random.randint(1, 10)
versuche = 0

print("Ich habe mir eine Zahl zwischen 1 und 10 gemerkt. Errate sie!")

while True:
    eingabe = int(input("Dein Tipp: "))
    versuche += 1

    if eingabe < geheime_zahl:
        print("Zu klein!")
    elif eingabe > geheime_zahl:
        print("Zu groß!")
    else:
        print(f"Richtig! Du hast {versuche} Versuch(e) gebraucht.")
        break
